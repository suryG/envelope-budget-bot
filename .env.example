# Supabase PostgreSQL connection string
# Get this from Supabase project settings -> Database -> Connection string (URI, "Transaction" mode)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# The WhatsApp group ID the bot should listen to and post in.
# You'll get this printed to the console the first time the bot runs and sees your groups.
WHATSAPP_GROUP_ID=""

# Port for the Express health-check server (Render sets this automatically, but keep a default)
PORT=3000
